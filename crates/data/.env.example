# pipa-data doesn't run standalone (it's a lib), but this documents the config surface
# `pipa_data::ObjectStoreConfig::from_env()` reads — consumed by both pipa-core and pipa-rest.
# Values shown are the built-in defaults (a local RustFS instance started via
# `just rustfs` / `just local::up`); override only what differs in your environment.

# RustFS / S3-compatible object store connection
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=pipa
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
# Allow plain HTTP to the endpoint (set to false once RUSTFS_ENDPOINT is https://)
RUSTFS_ALLOW_HTTP=true
