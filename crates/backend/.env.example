# pipa-backend: the facade HTTP API (DataFusion/Iceberg queries and
# OLTP data source management) for every external caller, including the pipa-ui dashboard.
# Always listens on 0.0.0.0:8080 (not currently configurable via env).

# RustFS / S3-compatible object store connection (same store pipa-ingestion reads from)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=pipa
RUSTFS_REGION=ap-southeast-3
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_ALLOW_HTTP=true

# Iceberg REST catalog connection, used by `POST /query` (crates/backend/src/iceberg/query.rs)
# to run DataFusion SQL over Iceberg tables. Defaults to RustFS's own embedded "S3 Tables"
# Iceberg REST Catalog (same host/port as its S3 API, under /iceberg) rather than a
# separately-run catalog service — but the "pipa" bucket must have S3 Tables enabled on it
# first (a manual step against RustFS, not automated here — see the note in docker-compose.yml).
ICEBERG_CATALOG_NAME=pipa
ICEBERG_CATALOG_URI=http://localhost:9000/iceberg
ICEBERG_CATALOG_WAREHOUSE=pipa

# Log verbosity for tracing_subscriber::fmt::init(), e.g. "info" or "pipa_backend=debug,info"
RUST_LOG=info
