# pipa-backend: the facade HTTP API (DataFusion/Iceberg queries and
# OLTP data source management) for every external caller, including the pipa-ui dashboard.
# Always listens on 0.0.0.0:8080 (not currently configurable via env).

# RustFS / S3-compatible object store connection (same store pipa-ingestion reads from)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=pipa
RUSTFS_REGION=ap-southeast-3
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_ALLOW_HTTP=true

# Iceberg REST catalog connection, used by `POST /query` (crates/backend/src/iceberg/query.rs)
# to run DataFusion SQL over Iceberg tables. Left unset, ICEBERG_CATALOG_URI means RustFS's own
# embedded "S3 Tables" Iceberg REST Catalog at RUSTFS_ENDPOINT, reached through the
# pipa-catalog-proxy signer embedded in this process (that catalog rejects unsigned requests),
# which also enables S3 Tables on RUSTFS_BUCKET at startup. Set it only for some other catalog.
ICEBERG_CATALOG_NAME=pipa
# ICEBERG_CATALOG_URI=
ICEBERG_CATALOG_WAREHOUSE=pipa

# Authentication. JWT_SECRET signs login tokens and is REQUIRED (at least 32 bytes, e.g.
# `openssl rand -base64 48`) — the backend refuses to start without it.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# The first admin, created on startup only while no user exists yet (ignored afterwards; manage
# users through the dashboard's Users page). The backend refuses to start with no users and
# these unset.
PIPA_ADMIN_USERNAME=admin
PIPA_ADMIN_PASSWORD=change-me
# Browser origins allowed to call the API, comma-separated (default: the local dev UI).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Log verbosity for tracing_subscriber::fmt::init(), e.g. "info" or "pipa_backend=debug,info"
RUST_LOG=info
