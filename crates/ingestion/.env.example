# pipa-ingestion: the CDC engine. Standalone service — reads registered OLTP data sources
# directly from the shared RustFS object store's `datasources/` JSON layout (see
# datasource.rs; this crate takes no dependency on pipa-backend) and, for Postgres sources,
# streams changes via logical replication (see
# crates/ingestion/src/capture/infrastructure/postgres/).

# RustFS / S3-compatible object store connection (same store pipa-backend writes to)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=pipa
RUSTFS_REGION=ap-southeast-3
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_ALLOW_HTTP=true

# Iceberg REST catalog that captured changes are written to (same catalog pipa-backend queries).
# Left unset, ICEBERG_CATALOG_URI means RustFS's embedded S3 Tables catalog at RUSTFS_ENDPOINT,
# reached through the pipa-catalog-proxy signer embedded in this process (that catalog rejects
# unsigned requests), which also enables S3 Tables on RUSTFS_BUCKET at startup. Set it only for
# some other catalog.
ICEBERG_CATALOG_NAME=pipa
# ICEBERG_CATALOG_URI=
ICEBERG_CATALOG_WAREHOUSE=pipa

# Per-target-table batching: flush after this many events or this many milliseconds, whichever
# comes first. Defaults shown.
INGESTION_BATCH_MAX_EVENTS=1000
INGESTION_BATCH_FLUSH_INTERVAL_MS=5000

# Static sharding for running multiple instances: this instance only captures sources whose
# id falls into shard INGESTION_SHARD_INDEX of INGESTION_SHARD_COUNT total shards (0-indexed).
# Defaults below mean "single instance, handles every registered source".
INGESTION_SHARD_INDEX=0
INGESTION_SHARD_COUNT=1

# Log verbosity for tracing_subscriber::fmt::init(), e.g. "info" or "pipa_ingestion=debug,info"
RUST_LOG=info

# --- Testing only (crates/ingestion/src/capture/infrastructure/postgres/mod.rs::live_tests) ---
# Used by the #[ignore]d postgres_wal_source_streams_real_changes test, which needs a real
# Postgres reachable here with wal_level=logical and a `testdb.orders` table (see that
# test's doc comment). Not read by the pipa-ingestion binary itself.
#PIPA_TEST_PG_HOST=127.0.0.1
#PIPA_TEST_PG_PORT=55432
