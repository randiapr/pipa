# pipa-rest: the facade HTTP API in front of pipa-data (DataFusion/Iceberg queries and
# OLTP data source management) for every external caller, including the pipa-ui dashboard.
# Always listens on 0.0.0.0:8080 (not currently configurable via env).

# RustFS / S3-compatible object store connection (same store pipa-core reads from)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=pipa
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_ALLOW_HTTP=true

# Log verbosity for tracing_subscriber::fmt::init(), e.g. "info" or "pipa_rest=debug,info"
RUST_LOG=info
