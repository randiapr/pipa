# pipa-core: the CDC engine. Reads registered OLTP data sources from the shared RustFS
# object store (see crates/data/.env.example for what ObjectStoreConfig::from_env() reads)
# and, for Postgres sources, streams changes via logical replication (see
# crates/core/src/capture/infrastructure/postgres/).

# RustFS / S3-compatible object store connection (same store pipa-rest writes to)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=pipa
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_ALLOW_HTTP=true

# Log verbosity for tracing_subscriber::fmt::init(), e.g. "info" or "pipa_core=debug,info"
RUST_LOG=info

# --- Testing only (crates/core/src/capture/infrastructure/postgres/mod.rs::live_tests) ---
# Used by the #[ignore]d postgres_wal_source_streams_real_changes test, which needs a real
# Postgres reachable here with wal_level=logical and a `testdb.orders` table (see that
# test's doc comment). Not read by the pipa-core binary itself.
#PIPA_TEST_PG_HOST=127.0.0.1
#PIPA_TEST_PG_PORT=55432
