# Read by docker-compose.yml (copy to `.env` and fill in; `.env` is gitignored).
# `just docker-up` does this for you: it creates `.env` and fills any blank secret below with a
# random value on first run.

# Signs pipa-backend's login tokens. Required, at least 32 bytes: `openssl rand -base64 48`
PIPA_JWT_SECRET=

# The first admin, created by pipa-backend while no user exists yet.
PIPA_ADMIN_USERNAME=admin
PIPA_ADMIN_PASSWORD=

# Browser origins allowed to call pipa-backend, comma-separated. Defaults to the dashboard
# served by this compose file (http://localhost:3000); set it when serving the UI elsewhere.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
